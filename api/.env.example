# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings


NODE_ENV=production # change locally to get test endpoint

BACKEND_SERVER_HOST=BACKEND_SERVER_HOST # define locally for fastify, in prod is set as 0.0.0.0
BACKEND_SERVER_PORT=BACKEND_SERVER_PORT # required

# These are used to run postgres-db-migrate service to set-up and seed DB
POSTGRES_USER=POSTGRES_USER
POSTGRES_PASSWORD=POSTGRES_PASSWORD
POSTGRES_DB=POSTGRS_DB

DATABASE_URL=DATABASE_URL # defined in both env, in prod used to set full url (upstash, etc.)
LOCAL_PRISMA_DATABASE_URL=LOCAL_PRISMA_DATABASE_URL # stores url to run `npx prisma studio`, not required for app to run

REDIS_URL=REDIS_URL # define locally for fastify, set in prod for inter-container

STRIPE_SECRET_KEY=STRIPE_SECRET_KEY # required
STRIPE_ENDPOINT_SECRET=STRIPE_ENDPOINT_SECRET #required

SIGNING_SECRET=SIGNING_SECRET # required
RESEND_SECRET_KEY=RESEND_SECRET_KEY #required

RATE_LIMIT_ALLOWLIST=CSV of IPs allowed to bypass rate limit (for testing)