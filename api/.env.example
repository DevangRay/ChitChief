NODE_ENV=production # change locally to get test endpoint

# BACKEND_SERVER_HOST=BACKEND_SERVER_HOST # define locally for fastify, in prod is set as 0.0.0.0 by default
# BACKEND_SERVER_PORT=BACKEND_SERVER_PORT # required

# required for prod, in local dev this is optional and can be set to the same as BACKEND_SERVER_PORT or left undefined
PORT=PORT
# PROD ONLY, local dev requires this to be null
DEPLOYED_BACKEND_URL=DEPLOYED_BACKEND_URL
DEPLOYED_HEALTHCHECK_URL=healthcheck.railway.app

DATABASE_URL=DATABASE_URL # required

REDIS_URL=REDIS_URL # required

STRIPE_SECRET_KEY=STRIPE_SECRET_KEY # required
STRIPE_ENDPOINT_SECRET=STRIPE_ENDPOINT_SECRET #required

SIGNING_SECRET=SIGNING_SECRET # required
RESEND_SECRET_KEY=RESEND_SECRET_KEY #required

# Optional
RATE_LIMIT_ALLOWLIST=CSV of IPs allowed to bypass rate limit (for testing)

# DEVELOPMENT ONLY
LOCAL_PRISMA_DATABASE_URL=LOCAL_PRISMA_DATABASE_URL # stores url to run `npx prisma studio`, not required for app to run

# These are used to run postgres-db-migrate service to set-up and seed DB
POSTGRES_USER=POSTGRES_USER
POSTGRES_PASSWORD=POSTGRES_PASSWORD
POSTGRES_DB=POSTGRS_DB